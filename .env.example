# ==========================================================================
# 운세 한 스푼 — 환경변수 예시
# 실제 값은 .env.local (로컬) / Vercel Environment Variables (배포)에 넣으세요.
# 이 파일(.env.example)은 커밋해도 되지만, 실제 키가 든 파일은 커밋 금지입니다.
# ==========================================================================

# ---------- Supabase (필수: 로그인·저장 기능) ----------
# Supabase 대시보드 > Project Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 비밀키 — 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요. (클라이언트 번들 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# ---------- 사이트 주소 ----------
# 로컬: http://localhost:3000 / 배포: https://내도메인
# 카카오 로그인 리다이렉트와 공유 링크에 사용됩니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- 카카오 로그인 (필수: 로그인) ----------
# 카카오 디벨로퍼스 > 앱 > 플랫폼 키 > REST API 키 의 클라이언트 ID / 클라이언트 시크릿.
# 서버 전용 값이라 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
# 카카오는 OIDC(openid) id_token 으로 로그인하고, 서버에서 Supabase 세션으로 교환합니다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# ---------- 수익화 (선택) ----------
# 구글 애드센스 승인 후 입력. 비워 두면 디자인용 광고 자리(placeholder)만 표시됩니다.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_RESULT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_RESULT_BOTTOM=
# 카카오 애드핏 (애드센스 대신 사용할 때). 비워 두면 표시되지 않습니다.
NEXT_PUBLIC_ADFIT_UNIT=

# ---------- 토스페이먼츠 결제 (유료 코인 충전) ----------
# 토스페이먼츠 개발자센터 > 내 상점 > API 키 에서 확인합니다.
# - 테스트 키: test_ck_... / test_sk_...  (가입만 하면 바로 발급, 실제 돈 안 나감)
# - 실키:      live_ck_... / live_sk_...  (사업자 심사·계약 후 발급)
# 두 값이 모두 있으면 실결제(결제창) 모드, 없으면 "테스트 결제 모드"로 동작합니다.
# TOSS_SECRET_KEY 는 서버 승인 전용 — 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ---------- 사업자 정보 (푸터·이용약관 표시) ----------
# 통신판매업 신고 후 실제 값으로 바꿔 주세요.
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_BUSINESS_OWNER=
NEXT_PUBLIC_BUSINESS_NUMBER=
NEXT_PUBLIC_BUSINESS_MAIL_ORDER=
NEXT_PUBLIC_BUSINESS_ADDRESS=

# 쿠팡 파트너스 추적 ID (기본값 AF6829761)
NEXT_PUBLIC_COUPANG_PARTNER_ID=AF6829761

# 개인정보처리방침에 표시할 문의 이메일 (선택)
NEXT_PUBLIC_CONTACT_EMAIL=
