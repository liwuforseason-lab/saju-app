# ==========================================================================
# 운세 한 스푼 — 환경변수 예시
# 실제 값은 .env.local (로컬) / Vercel Environment Variables (배포)에 넣으세요.
# 이 파일(.env.example)은 커밋해도 되지만, 실제 키가 든 파일은 커밋 금지입니다.
# ==========================================================================

# ---------- Supabase (필수: 로그인·저장 기능) ----------
# Supabase 대시보드 > Project Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 비밀키 — 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요. (클라이언트 번들 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# ---------- 사이트 주소 ----------
# 로컬: http://localhost:3000 / 배포: https://내도메인
# 카카오 로그인 리다이렉트와 공유 링크에 사용됩니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- 수익화 (선택) ----------
# 구글 애드센스 승인 후 입력. 비워 두면 디자인용 광고 자리(placeholder)만 표시됩니다.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_RESULT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_RESULT_BOTTOM=
# 카카오 애드핏 (애드센스 대신 사용할 때). 비워 두면 표시되지 않습니다.
NEXT_PUBLIC_ADFIT_UNIT=

# 쿠팡 파트너스 추적 ID (기본값 AF6829761)
NEXT_PUBLIC_COUPANG_PARTNER_ID=AF6829761

# 개인정보처리방침에 표시할 문의 이메일 (선택)
NEXT_PUBLIC_CONTACT_EMAIL=
